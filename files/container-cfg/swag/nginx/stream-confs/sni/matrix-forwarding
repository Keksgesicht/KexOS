# facing SSL/SNI-Proxy
geo $upstream_443 {
    default           1443;
    192.168.0.0/16    2443;
    fd00::/16         2443;
}


# WAN switch - downstream SNI-Proxy
map $ssl_preread_server_name $upstream_1443 {
    hostnames;
    # https://datatracker.ietf.org/doc/html/rfc863
    *.cookieclicker.keksgesicht.de 9;
    *.cookieflyer.keksgesicht.de 9;
    *.keksgesicht.de    8443;
}


# LAN switch - upstream or downstream SNI-proxy
map $ssl_preread_server_name $upstream_2443 {
    hostnames;
    default             3443;
    *.keksgesicht.de    8443;
    keksgesicht.de      8443;
}
