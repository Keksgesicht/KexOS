#!/usr/bin/env zsh

if (( $+commands[nano] )); then
    EDITOR="nano"
elif (( $+commands[nvim] )); then
    EDITOR="nvim"
elif (( $+commands[vim] )); then
    EDITOR="vim"
elif (( $+commands[vi] )); then
    EDITOR="vi"
fi

if [ -n "$EDITOR" ]; then
    VISUAL="$EDITOR"
    SUDO_EDITOR="$EDITOR"
    export EDITOR
    export VISUAL
    export SUDO_EDITOR
fi

tabs -4
LESS="$LESS -x4"
export LESS
MOOR="$MOOR --shift 4"
MOOR+=" --quit-if-one-screen"
MOOR+=" --mousemode select"
MOOR+=" --no-clear-on-exit"
export MOOR

if (( $+commands[moor] )); then
    export PAGER="moor"
    export SYSTEMD_PAGER="$PAGER"
    export SYSTEMD_PAGERSECURE="false"
elif (( $+commands[less] )); then
    export PAGER="less"
fi

export OPENER="xdg-open"
export SHELL=$(which zsh)
