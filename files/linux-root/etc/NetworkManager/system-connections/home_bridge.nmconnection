[connection]
id=home_bridge
uuid=85fd4d4d-73fd-4375-82c4-130e05ace48e
type=bridge
interface-name=br-home

[ethernet]

[bridge]

[ipv4]
method=manual
address1=@ipaddr@
dns=@dnsserver@
gateway=@gateway@
may-fail=false
route-metric=789

[ipv6]
method=auto
ignore-auto-dns=true
ip6-privacy=0
addr-gen-mode=stable-privacy
route-metric=1234

[proxy]
